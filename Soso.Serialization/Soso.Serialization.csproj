<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <!-- NuGet Package Metadata -->
        <PackageId>soso.serialization</PackageId>
        <Version>1.0.0</Version>
        <Authors>Ky Price</Authors>
        <Company>Chronic Vagrant</Company>
        <Description>A reasonably lightweight binary serialization library</Description>
        <PackageTags>serialization;binary;utils</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mkyprice/Soso.Serialization</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Automatically build package on every Release build -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="soso.utils.logging" Version="1.1.0" />
    </ItemGroup>

</Project>
